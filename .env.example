# Copy to .env and fill in your own values. Never commit .env.
VIGIL_STORE_URL=http://localhost:8000
VIGIL_API_KEY=replace-me-with-a-long-random-string
# Optional: one key per project, tied to the site tag. Format: site:key,site:key (keys at least 16 characters)
# VIGIL_PROJECT_KEYS=site-a:replace-me-with-a-long-random-string
# Optional: uptime checks. Set VIGIL_CHECKS as a Fly secret and never in fly.toml because the URLs identify client sites.
# VIGIL_CHECKS=site-a=https://site-a.example.com,site-b=https://site-b.example.com
# Interval in seconds (default 300, minimum 30):
# VIGIL_CHECK_INTERVAL=300
# Environment tag recorded on uptime check points (default prod):
# VIGIL_CHECK_ENV=prod

