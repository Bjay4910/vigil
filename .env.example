# Copy to .env and fill in your own values. Never commit .env.
VIGIL_STORE_URL=http://localhost:8000
VIGIL_API_KEY=replace-me-with-a-long-random-string
# Optional: one key per project, tied to the site tag. Format: site:key,site:key (keys at least 16 characters)
# VIGIL_PROJECT_KEYS=site-a:replace-me-with-a-long-random-string
# Optional: uptime checks. Set VIGIL_CHECKS as a Fly secret and never in fly.toml because the URLs identify client sites.
# VIGIL_CHECKS=site-a=https://site-a.example.com,site-b=https://site-b.example.com
# Interval in seconds (default 300, minimum 30):
# VIGIL_CHECK_INTERVAL=300
# Environment tag recorded on uptime check points (default prod):
# VIGIL_CHECK_ENV=prod
# Optional: alerting via a Discord or Slack webhook URL. It is a secret; set VIGIL_ALERT_WEBHOOK as a Fly secret and never in fly.toml or the repo.
# VIGIL_ALERT_WEBHOOK=https://discord.com/api/webhooks/000000000/replace-me
# Daily digest local hour 0..23 (default 8):
# VIGIL_DIGEST_HOUR=8
# Daily digest IANA timezone (default America/New_York):
# VIGIL_DIGEST_TZ=America/New_York
# Maximum non-digest alert messages per rolling hour (default 20, 1..200):
# VIGIL_ALERT_MAX_PER_HOUR=20
# Environment tag watched by alerting (default prod):
# VIGIL_ALERT_ENV=prod
# Test your webhook configuration with: python -m store.alerts --test
# Optional: request rate limit per minute per client address (default 300, 0 disables):
# VIGIL_RATE_LIMIT=300
# Wrong-key requests within 5 minutes before a 10-minute lockout per address (default 10, 0 disables):
# VIGIL_AUTH_FAIL_LIMIT=10
# Maximum POST /ingest request body size in bytes (default 1000000):
# VIGIL_MAX_BODY_BYTES=1000000
# Maximum points accepted in a single POST /ingest request (default 5000):
# VIGIL_MAX_POINTS=5000

